PORT=8000
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

LLM_MODEL=mistral:latest
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT=120
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_FILE=data/vector_index/faiss_index
EMBEDDING_DIMENSION=384
FAISS_METRIC=L2
TOP_K_DOCUMENTS=5
SIMILARITY_THRESHOLD=0.4

CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_LENGTH=50

AUDIT_DB_PATH=logs/audit_log.db
AUDIT_RETENTION_DAYS=2555
AUDIT_BATCH_SIZE=100

RESTRICTED_ENTITIES_CSV=Data1/Data/Restricted_Entities_Registry.csv
APPROVED_ALTERNATIVES_CSV=Data1/Data/Approved_Alternatives_Registry.csv
DATA_SOURCE_DIR=Data1
GRAPH_DB_PATH=data/knowledge_graph.db
GRAPH_MAX_SOURCE_CHARS=2000
GRAPH_REBUILD_CHUNK_LIMIT=0

# Comma-separated list for production frontend origins
CORS_ORIGINS=*

